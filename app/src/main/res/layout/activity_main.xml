<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="REGISTRO DE APUNTES"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignatura:"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spinnerAsignatura"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnAgregarAsignatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Asignatura"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tema (Sin símbolos):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. Ciclo de vida de una Activity"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha (AAAA-MM-DD):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2026-10-17"
            android:inputType="date"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top|start"
            android:hint="Escribe o dicta la descripción..."
            android:inputType="textMultiLine"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDictar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 Dictar Descripción por Voz"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nota de Voz:"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnGrabar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="🔴 Grabar" />

            <Button
                android:id="@+id/btnReproducirGrabacion"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="▶ Reproducir"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSalvarApunte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar Apunte"
            android:backgroundTint="@color/material_dynamic_primary50"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnVerApuntes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Apuntes" />

    </LinearLayout>
</ScrollView>
