<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Parte superior: UTH en verde y mayúscula, y contador de tiempo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="UTH"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00:00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginBottom="12dp" />

        <!-- Botones Grabar y Reproducir arriba -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnGrabar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎙️" />

            <Button
                android:id="@+id/btnReproducirGrabacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="▶ " />
        </LinearLayout>

        <!-- Asignatura -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignatura:"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spinnerAsignatura"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnAgregarAsignatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Asignatura"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Tema -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tema (Sin símbolos):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. Ciclo de vida de una Activity"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- Fecha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha (AAAA-MM-DD):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="2026-10-17"
            android:inputType="date"
            android:layout_marginBottom="12dp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top|start"
            android:hint="Escribe o dicta la descripción..."
            android:inputType="textMultiLine"
            android:layout_marginBottom="8dp" />

        <!-- Dictar -->
        <Button
            android:id="@+id/btnDictar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 Dictar Descripción por Voz"
            android:layout_marginBottom="16dp" />

        <!-- Botones de Acción -->
        <Button
            android:id="@+id/btnSalvarApunte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar Apunte"
            android:backgroundTint="@color/material_dynamic_primary50"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnVerApuntes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Apuntes" />

    </LinearLayout>
</ScrollView>
